<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền cần thiết để truy cập Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logoandroid"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logoandroid"
        android:supportsRtl="true"
        android:theme="@style/Theme.Login"
        android:usesCleartextTraffic="true"> <!-- Cho phép kết nối HTTP -->

        <activity

            android:name=".LoginActivity"

            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity"/>
        <activity android:name=".ForgotPasswordActivity"/>
        <activity android:name=".RegisterActivity"/>
        <activity android:name=".TutorDashboardActivity"/>
        <activity android:name=".StudentDashboardActivity"/>
        <activity android:name=".AdminDashboardActivity"/>
        <activity android:name=".DetailCourseActivity"/>
        <activity android:name=".DetailCourseActivity_admin"/>
        <activity android:name=".DetailCourseActivity_st"/>
        <activity android:name=".UpdateCourseActivity"/>
        <activity android:name=".ManagermentConfirmCourse_admin"/>

<!--        android:name=".LoginActivity"-->
<!--        <activity android:name=".AdminDashboardActivity"/>-->
        <!--            android:name=".LoginActivity"-->
    </application>
</manifest>


