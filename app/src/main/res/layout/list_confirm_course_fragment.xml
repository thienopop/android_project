<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="6dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:contentPadding="12dp">

    <!-- Root Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- LEFT: Course info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subject"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/txtTutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tutor Name"
                android:textColor="#555555"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txtTotalSession"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Session: 10"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txtTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Price: 2,000,000đ"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txtSessionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start: 2024-11-02 14:00"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txtNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note: ..."
                android:textColor="#888888"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- RIGHT: Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/blue"
                android:text="@string/cancel" />
            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/blue"
                android:text="@string/confirm" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>